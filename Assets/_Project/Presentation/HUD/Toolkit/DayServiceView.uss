.day-service-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.panel-title {
    font-size: 24px;
    color: #FFD700;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.soul-cards-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
}

.soul-card {
    width: 160px;
    height: 200px;
    background-color: rgba(40, 40, 60, 0.9);
    border-color: #555;
    border-width: 2px;
    border-radius: 8px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: background-color 0.2s;
}

.soul-card:hover {
    background-color: rgba(60, 60, 90, 0.9);
}

.soul-card[data-state="Saved"] {
    border-color: #4CAF50;
    background-color: rgba(76, 175, 80, 0.3);
}

.soul-card[data-state="Abandoned"] {
    border-color: #F44336;
    background-color: rgba(244, 67, 54, 0.3);
}

.soul-name {
    font-size: 18px;
    color: white;
    margin-bottom: 8px;
}

.soul-state {
    font-size: 14px;
    color: #AAA;
}

.ritual-source-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
}

.ritual-source {
    width: 100px;
    height: 60px;
    background-color: rgba(60, 40, 20, 0.9);
    border-color: #8B6914;
    border-width: 2px;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: background-color 0.2s;
}

.ritual-source:hover {
    background-color: rgba(100, 70, 30, 0.9);
}

.ritual-source-label {
    font-size: 14px;
    color: #FFD700;
    -unity-text-align: middle-center;
}

.ritual-icon {
    font-size: 12px;
    color: #FFD700;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.validation-status {
    font-size: 14px;
    color: #CCC;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    min-height: 20px;
}

.confirm-container {
    justify-content: center;
    align-items: center;
}

.confirm-button {
    width: 200px;
    height: 44px;
    font-size: 18px;
    color: white;
    background-color: #4CAF50;
    border-radius: 6px;
    cursor: pointer;
}

.confirm-button:disabled {
    background-color: #555;
    color: #999;
    cursor: default;
}

.choice-lock-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
}

.lock-text {
    font-size: 28px;
    color: #FFD700;
    -unity-text-align: middle-center;
}
